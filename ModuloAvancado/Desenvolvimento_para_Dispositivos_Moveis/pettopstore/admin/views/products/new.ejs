<h1>Criar produto</h1>
<form method="POST" action="/products/create" enctype="multipart/form-data">
  Foto: <input type="file" name="photo" required /><br/><br/>
  Nome: <input type="text" name="name" required /><br/><br/>
  Preço: <input type="text" name="price" required /><br/><br/>
  Descrição: <textarea name="description"></textarea><br/><br/>
  
  Categoria:
  <select name="category_id" required>
    <% for (const category of categories) { %>
      <option value="<%= category.id %>"><%= category.name %></option>
    <% } %>
  </select><br/><br/>

  <input type="submit" value="Salvar produto" />
</form>